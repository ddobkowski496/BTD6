<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Mini Tower Defense - GitHub Edition</title>
    <style>
        body {
            margin: 0;
            background: #2c3e50;
            color: #fff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }
        #game-container {
            position: relative;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            border-radius: 8px;
            overflow: hidden;
        }
        canvas {
            background: #27ae60;
            display: block;
        }
        #ui {
            display: flex;
            justify-content: space-between;
            background: #34495e;
            padding: 10px 20px;
            font-size: 18px;
            font-weight: bold;
        }
        .stats span { margin-right: 20px; }
        .shop-btn {
            background: #e67e22;
            border: none;
            color: white;
            padding: 5px 15px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }
        .shop-btn:hover { background: #d35400; }
        .shop-btn.active { box-shadow: 0 0 0 3px #fff; }
    </style>
</head>
<body>

<div id="game-container">
    <div id="ui">
        <div class="stats">
            Cash: $<span id="cash">200</span>
            Lives: <span id="lives">20</span>
            Wave: <span id="wave">1</span>
        </div>
        <button class="shop-btn" id="buy-tower">Buy Dart Monkey ($100)</button>
    </div>
    <canvas id="gameCanvas" width="800" height="500"></canvas>
</div>

<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

// Game State
let cash = 200;
let lives = 20;
let wave = 1;
let placingTower = false;
let waveInProgress = false;

const path = [
    {x: 0, y: 150},
    {x: 300, y: 150},
    {x: 300, y: 380},
    {x: 600, y: 380},
    {x: 600, y: 100},
    {x: 800, y: 100}
];

let enemies = [];
let towers = [];
let projectiles = [];

// UI Interaction
const buyBtn = document.getElementById('buy-tower');
buyBtn.addEventListener('click', (e) => {
    if (cash >= 100) {
        placingTower = !placingTower;
        buyBtn.classList.toggle('active', placingTower);
    }
    e.stopPropagation();
});

canvas.addEventListener('click', (e) => {
    if (!placingTower) return;
    
    const rect = canvas.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;

    if (cash >= 100) {
        towers.push({ x, y, range: 120, fireRate: 30, cooldown: 0, damage: 1 });
        cash -= 100;
        placingTower = false;
        buyBtn.classList.remove('active');
        updateUI();
    }
});

function updateUI() {
    document.getElementById('cash').innerText = cash;
    document.getElementById('lives').innerText = lives;
    document.getElementById('wave').innerText = wave;
}

// Enemy Spawning Loop
setInterval(() => {
    if (lives <= 0) return;
    if (enemies.length === 0 && !waveInProgress) {
        waveInProgress = true;
        let spawned = 0;
        const spawnInterval = setInterval(() => {
            enemies.push({
                x: path[0].x,
                y: path[0].y,
                targetNode: 1,
                speed: 1.5 + (wave * 0.2),
                hp: Math.ceil(wave * 1.5),
                maxHp: Math.ceil(wave * 1.5),
                radius: 12
            });
            spawned++;
            if (spawned >= 5 + wave * 2) {
                clearInterval(spawnInterval);
                waveInProgress = false;
                wave++;
            }
        }, 800);
    }
}, 3000);

// Core Mechanics
function gameLoop() {
    if (lives <= 0) {
        ctx.fillStyle = "rgba(0,0,0,0.7)";
        ctx.fillRect(0,0,canvas.width,canvas.height);
        ctx.fillStyle = "#fff";
        ctx.font = "40px sans-serif";
        ctx.fillText("GAME OVER", canvas.width/2 - 120, canvas.height/2);
        return;
    }

    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // Draw Map Path
    ctx.strokeStyle = '#f1c40f';
    ctx.lineWidth = 40;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.beginPath();
    ctx.moveTo(path[0].x, path[0].y);
    for(let i=1; i<path.length; i++) ctx.lineTo(path[i].x, path[i].y);
    ctx.stroke();

    // Move & Draw Enemies
    for (let i = enemies.length - 1; i >= 0; i--) {
        let e = enemies[i];
        let target = path[e.targetNode];
        let dx = target.x - e.x;
        let dy = target.y - e.y;
        let dist = Math.hypot(dx, dy);

        if (dist < e.speed) {
            e.targetNode++;
            if (e.targetNode >= path.length) {
                lives--;
                enemies.splice(i, 1);
                updateUI();
                continue;
            }
        } else {
            e.x += (dx / dist) * e.speed;
            e.y += (dy / dist) * e.speed;
        }

        // Draw Bloon
        ctx.fillStyle = '#e74c3c';
        ctx.beginPath();
        ctx.arc(e.x, e.y, e.radius, 0, Math.PI * 2);
        ctx.fill();
    }

    // Process Towers
    towers.forEach(t => {
        // Draw Monkey
        ctx.fillStyle = '#8e44ad';
        ctx.beginPath();
        ctx.arc(t.x, t.y, 18, 0, Math.PI * 2);
        ctx.fill();

        if (t.cooldown > 0) t.cooldown--;

        if (t.cooldown === 0 && enemies.length > 0) {
            // Target closest enemy inside range
            let target = null;
            for (let e of enemies) {
                if (Math.hypot(e.x - t.x, e.y - t.y) <= t.range) {
                    target = e;
                    break;
                }
            }
            if (target) {
                projectiles.push({ x: t.x, y: t.y, target: target, speed: 7 });
                t.cooldown = t.fireRate;
            }
        }
    });

    // Process Darts (Projectiles)
    for (let i = projectiles.length - 1; i >= 0; i--) {
        let p = projectiles[i];
        if (!enemies.includes(p.target)) {
            projectiles.splice(i, 1);
            continue;
        }

        let dx = p.target.x - p.x;
        let dy = p.target.y - p.y;
        let dist = Math.hypot(dx, dy);

        if (dist < p.speed) {
            p.target.hp -= 1;
            if (p.target.hp <= 0) {
                cash += 15;
                enemies.splice(enemies.indexOf(p.target), 1);
                updateUI();
            }
            projectiles.splice(i, 1);
        } else {
            p.x += (dx / dist) * p.speed;
            p.y += (dy / dist) * p.speed;

            // Draw Dart
            ctx.fillStyle = '#ecf0f1';
            ctx.beginPath();
            ctx.arc(p.x, p.y, 4, 0, Math.PI * 2);
            ctx.fill();
        }
    }

    requestAnimationFrame(gameLoop);
}

gameLoop();
</script>
</body>
</html>
